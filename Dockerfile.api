# 클라우드 대시보드 이미지.  담당: 문태현 (배포)
#
# 개발용 Dockerfile 은 torch · OpenCV · YOLO · EasyOCR 까지 들어 있어 수 GB 다. 클라우드 서버는
# 기록을 받아 보여 주기만 해서(api/cloud.py) 그것들이 필요 없다. 무료 · 저가 서버는 메모리와
# 디스크가 작아서, 이 작은 이미지만 올린다.
#
#     docker build -f Dockerfile.api -t jarviseo-api .
#     docker run --rm -p 8000:8000 jarviseo-api       # http://localhost:8000/health

FROM python:3.12-slim

WORKDIR /app

COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

# 코드는 src 만 넣는다. data/ · 모델 · .env 는 .dockerignore 로 빠진다.
# 비밀값(DB 주소 · 비밀번호)은 이미지에 굽지 않고 실행할 때 환경변수로 준다.
COPY src ./src

ENV PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# 클라우드 서버는 보통 PORT 환경변수로 열 포트를 알려 준다. 없으면 8000.
EXPOSE 8000
CMD ["sh", "-c", "uvicorn jarviseo.api.cloud:app --host 0.0.0.0 --port ${PORT:-8000}"]
