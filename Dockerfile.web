# 팀 웹(api/main.py: 대시보드 · 물어보기 · 성분 확인)을 클라우드에서 띄우는 이미지.  담당: 문태현 (배포)
#
# 대시보드만 보여 주던 Dockerfile.api(api/cloud.py)와 달리, 웹에서 받은 사진으로 가리킴(YOLO · 손 관절) ·
# 성분 판정 · VLM 을 돌리므로 torch · OpenCV · mediapipe 가 다 들어간다(#179).
# 패키지를 까는 앞부분은 개발 이미지(Dockerfile)와 한 글자도 다르지 않게 둔다. 그래야 같은 빌드 캐시를 쓴다.
#
#     docker build -f Dockerfile.web -t jarviseo-web .
#     docker run --rm -p 8000:8000 --env-file .env jarviseo-web      # http://localhost:8000/

FROM python:3.12-slim

# OpenCV·MediaPipe 는 libGL, sounddevice 는 portaudio 가 있어야 import 부터 된다.
# slim 이미지에는 없어서 직접 넣는다. (ffmpeg 는 로컬 Whisper 를 뺀 뒤로 쓰는 곳이 없어 뺐다.)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libportaudio2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 버전은 requirements.lock(requirements.txt + requirements-dev.txt 를 uv 로 푼 것) 그대로 깐다.
# requirements.txt 는 하한(>=)만 있어서 빌드할 때마다 최신 버전이 들어와, 어제 되던 이미지가
# 오늘 깨질 수 있다. 9/19 에 만든 뒤 requirements 가 여러 번 바뀌어도 아무도 빌드를 확인하지 않았다.
#
# torch 만 CPU 판으로 **먼저** 따로 깐다. 잠금 파일은 리눅스에서 PyPI 의 CUDA 판 torch 와
# nvidia-*·cuda-* 패키지(수 GB)를 고르는데, 컨테이너는 GPU 를 쓰지 않는다. 학습은 Colab 에서 한다.
# 그래서 같은 버전의 CPU 판을 pytorch 저장소에서 받고, 잠금 파일에서는 그 줄들을 빼고 깐다.
COPY requirements.lock ./
RUN set -eux; \
    torch="$(grep -E '^torch==' requirements.lock | cut -d' ' -f1)"; \
    vision="$(grep -E '^torchvision==' requirements.lock | cut -d' ' -f1)"; \
    pip install --no-cache-dir "$torch" "$vision" --index-url https://download.pytorch.org/whl/cpu; \
    grep -vE "^(torch|torchvision)==|^cuda-|^triton|^nvidia-.*sys_platform == 'linux'" requirements.lock \
        > /tmp/requirements-cpu.lock; \
    pip install --no-cache-dir -r /tmp/requirements-cpu.lock; \
    rm /tmp/requirements-cpu.lock

# opencv-python · opencv-python-headless · opencv-contrib-python 은 셋 다 cv2 를 설치해서 서로 덮어쓴다.
# 잠금 파일에 셋이 다 있다(앱 · CI · mediapipe 가 각각 끌어온다). 어느 쪽이 남는지가 설치 순서에
# 달리지 않게, 셋 중 가장 넓은 contrib 를 마지막에 같은 버전으로 다시 깐다. 위에서 libGL 을 넣었으므로
# 화면 없는 컨테이너에서도 import 된다.
RUN contrib="$(grep -E '^opencv-contrib-python==' requirements.lock | cut -d' ' -f1)" \
    && pip install --no-cache-dir --no-deps --force-reinstall "$contrib"

# ── 여기부터 팀 웹 전용 ───────────────────────────────────────────────────────
# mediapipe 손 관절(HandLandmarker)은 리눅스에서 OpenGL ES · EGL 라이브러리를 연다. 없으면 첫 질문이
# "libGLESv2.so.2: cannot open shared object file" 로 500 이 난다(10/23 로컬 Docker 에서 확인).
# 위의 apt 줄에 넣으면 개발 이미지와 캐시를 못 나눠 패키지를 처음부터 다시 받으므로 여기 따로 둔다.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgles2 \
        libegl1 \
    && rm -rf /var/lib/apt/lists/*

# 첫 질문 때 받는 모델을 이미지에 미리 넣는다. 안 넣으면 컨테이너를 새로 띄울 때마다 첫 질문이
# 그만큼 늦어지고, 인터넷이 막히면 가리킴이 안 된다. 둘 다 Git 에 없다(data/models/*, *.pt).
#   yolov8n.pt          pointing/detector.py 가 지금 폴더(/app)에서 찾는다
#   hand_landmarker     config.HAND_LANDMARKER_PATH (data/models/hand_landmarker.task)
# EasyOCR 모델(약 100MB)은 넣지 않는다. 서버는 Google Vision 으로 읽고, EasyOCR 은 Vision 이
# 실패했을 때만 그 자리에서 받아 쓴다.
RUN python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')" \
    && mkdir -p data/models \
    && python -c "import urllib.request as u; u.urlretrieve('https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/latest/hand_landmarker.task', 'data/models/hand_landmarker.task')"

# 브라우저 호출어(#218) 모델 3개(약 2.6MB). 서버는 돌리지 않고 대시보드에 내려주기만 한다(/models/wakeword/).
# 팀 모델은 레포 릴리스, 공용 특징 모델 2개는 openWakeWord 릴리스. 받은 파일이 바뀌었으면 빌드를 멈춘다.
# jarviseo.onnx 를 바꾸면 scripts/download_models.py 의 주소 · SHA256 과 같이 바꾼다.
RUN python -c "import urllib.request as u; \
oww = 'https://github.com/dscripka/openWakeWord/releases/download/v0.5.1/'; \
u.urlretrieve('https://github.com/Mook-Industries/JARVISEO/releases/download/models-v1/jarviseo.onnx', 'data/models/jarviseo.onnx'); \
u.urlretrieve(oww + 'melspectrogram.onnx', 'data/models/melspectrogram.onnx'); \
u.urlretrieve(oww + 'embedding_model.onnx', 'data/models/embedding_model.onnx')" \
    && printf '%s\n' \
        "4686db10ae2febb837cadccf0e51e10b3bb9bccfdcc4b4820164fb73dd272b46  data/models/jarviseo.onnx" \
        "ba2b0e0f8b7b875369a2c89cb13360ff53bac436f2895cced9f479fa65eb176f  data/models/melspectrogram.onnx" \
        "70d164290c1d095d1d4ee149bc5e00543250a7316b59f31d056cff7bd3075c1f  data/models/embedding_model.onnx" \
    | sha256sum -c -

# 팀원이 학습한 가리킴 물체 검출기(#167). 레포 릴리스에 올린 .pt 를 받아 config.DETECTOR_WEIGHTS 로 쓴다.
# 비워 두면 받지 않고 위의 사전학습 yolov8n.pt 를 그대로 쓴다. 새 회차로 바꿀 때는 아래 두 줄만 고친다
# (docs/deploy.md "팀 모델을 서버에 올릴 때"). SHA256 이 다르면 빌드가 멈춰 서버는 전 버전 그대로다.
ARG DETECTOR_URL=""
ARG DETECTOR_SHA256=""
RUN if [ -n "$DETECTOR_URL" ]; then \
        python -c "import sys, urllib.request as u; u.urlretrieve(sys.argv[1], 'data/models/detector.pt')" "$DETECTOR_URL" \
        && echo "$DETECTOR_SHA256  data/models/detector.pt" | sha256sum -c -; \
    fi
ENV JARVISEO_DETECTOR_WEIGHTS=${DETECTOR_URL:+/app/data/models/detector.pt}

# 성분 판정이 읽는 알레르기 동의어 사전(레포에 있다).
COPY data/datasets/allergen_synonyms.json data/datasets/
COPY src ./src

ENV PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# 클라우드 서버는 보통 PORT 환경변수로 열 포트를 알려 준다. 없으면 8000.
EXPOSE 8000
CMD ["sh", "-c", "uvicorn jarviseo.api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
