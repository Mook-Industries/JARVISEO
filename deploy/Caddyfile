# 자비서 클라우드 앞단.  담당: 문태현 (배포)
#
# DOMAIN(예: jarviseo.duckdns.org)으로 들어온 요청을 팀 웹(api)으로 넘긴다.
# 도메인만 적어 두면 Caddy 가 Let's Encrypt 인증서를 받아 https 로 열고, http 는 https 로 돌린다.
# 인증서를 받으려면 도메인이 이 서버의 IP 를 가리키고 80·443 이 열려 있어야 한다.
#
# 접속 비밀번호(임시, #179): 팀 웹은 서버의 OpenAI · Vision 키로 질문을 처리해서, 주소만 알면 누구나
# 우리 키를 쓸 수 있다. 웹 담당과 정한 로그인이 들어오기 전까지 브라우저 기본 로그인 창으로 막는다.
# /health 만 열어 둔다(배포 확인 · CI). 비밀번호는 Parameter Store /jarviseo/BASIC_AUTH_PASSWORD 에
# 있고, update.sh 가 해시로 바꿔 BASIC_AUTH_HASH 로 넘긴다.

{$DOMAIN} {
	encode zstd gzip

	@private not path /health
	basic_auth @private {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	reverse_proxy api:8000
}
