# 이 파일을 .env 로 복사해서 각자 값을 채운다.
#   cp .env.example .env
# .env 는 절대 커밋하지 않는다 (.gitignore 에 이미 들어 있음).

# --- 프레임 입력 --------------------------------------------------------
# usbcam : 안경 카메라 (팀장 전용, 1대뿐)
# webcam : 노트북 내장 카메라
# video  : 녹화 영상 파일   -> JARVISEO_FRAME_PATH 필요
# folder : 이미지 폴더 순회 -> JARVISEO_FRAME_PATH 필요
JARVISEO_FRAME_SOURCE=webcam
JARVISEO_CAMERA_INDEX=0
JARVISEO_FRAME_WIDTH=1920
JARVISEO_FRAME_HEIGHT=1080
# JARVISEO_FRAME_PATH=data/videos/sample.mp4

# --- 프레임 품질 --------------------------------------------------------
# 30fps 기준 30 이면 약 1초치를 버퍼에 들고 있는다.
JARVISEO_FRAME_BUFFER_SIZE=30
# 이보다 흐리면 다시 찍는다. 실물 카메라 도착 후 다시 정해야 하는 값.
JARVISEO_SHARPNESS_THRESHOLD=100.0

# --- 지시 대상 특정 -----------------------------------------------------
# 1위-2위 점수차가 이보다 작으면 단정하지 않고 되묻는다.
JARVISEO_CLARIFY_MARGIN=0.15

# --- 기능 플래그 --------------------------------------------------------
# 아직 안 끝난 기능은 꺼둔 채로 main 에 머지한다.
# 내 브랜치에서 작업할 때만 true 로 켜서 확인한다.
JARVISEO_ENABLE_GAZE_CUE=false
JARVISEO_ENABLE_LANGUAGE_CUE=false
JARVISEO_ENABLE_BELONGING=false
JARVISEO_ENABLE_RECALL=false

# --- 외부 API -----------------------------------------------------------
# 팀 공용 키 1개. 팀장이 관리하고 월 사용 한도를 반드시 설정한다.
JARVISEO_LLM_API_KEY=
JARVISEO_VLM_MODEL=claude-sonnet-5

# --- 저장소 -------------------------------------------------------------
JARVISEO_SQLITE_PATH=data/jarviseo.db
JARVISEO_CHROMA_PATH=data/chroma

# --- 음성 ---------------------------------------------------------------
JARVISEO_WAKE_WORD=자비서
# TTS 재생이 끝난 뒤 마이크를 더 막아둘 시간(초). 되먹임 루프 방지.
JARVISEO_TTS_MIC_GATE_SEC=0.3
