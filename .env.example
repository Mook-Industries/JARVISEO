# 이 파일을 .env 로 복사해서 각자 값을 채운다.
#   cp .env.example .env
# .env 는 절대 커밋하지 않는다 (.gitignore 에 이미 들어 있음).

# --- 프레임 입력 --------------------------------------------------------
# usbcam : 안경 카메라 (팀에 1대뿐이라 돌아가며 쓴다)
# webcam : 노트북 내장 카메라
# video  : 녹화 영상 파일   -> JARVISEO_FRAME_PATH 필요
# folder : 이미지 폴더 순회 -> JARVISEO_FRAME_PATH 필요
JARVISEO_FRAME_SOURCE=webcam
JARVISEO_CAMERA_INDEX=0
JARVISEO_FRAME_WIDTH=1920
JARVISEO_FRAME_HEIGHT=1080
# JARVISEO_FRAME_PATH=data/videos/sample.mp4

# --- 프레임 품질 --------------------------------------------------------
# 30fps 기준 30 이면 약 1초치를 버퍼에 들고 있는다.
JARVISEO_FRAME_BUFFER_SIZE=30
# 이보다 흐리면 다시 찍는다. 실물 카메라 도착 후 다시 정해야 하는 값.
JARVISEO_SHARPNESS_THRESHOLD=100.0

# --- 지시 대상 특정 -----------------------------------------------------
# 1위-2위 점수차가 이보다 작으면 단정하지 않고 되묻는다.
JARVISEO_CLARIFY_MARGIN=0.15

# --- 기능 플래그 --------------------------------------------------------
# 아직 안 끝난 기능은 꺼둔 채로 main 에 머지한다.
# 내 브랜치에서 작업할 때만 true 로 켜서 확인한다.
JARVISEO_ENABLE_GAZE_CUE=false
JARVISEO_ENABLE_LANGUAGE_CUE=false
JARVISEO_ENABLE_RECALL=false

# --- 외부 API -----------------------------------------------------------
# 팀 공용 OpenAI 키 1개를 STT · VLM · TTS · 임베딩이 함께 쓴다. 월 사용 한도를 반드시 설정할 것.
# 이 키만 JARVISEO_ 가 안 붙는다. OpenAI SDK 가 찾는 이름 그대로 쓴다.
OPENAI_API_KEY=
# 모델 이름. 코드는 config.py 한 곳에서만 이 값을 읽는다.
JARVISEO_VLM_MODEL=gpt-6-sol
JARVISEO_STT_MODEL=gpt-transcribe
JARVISEO_TTS_MODEL=tts-1
# TTS 합성이 멈추면 이 모델로 한 번 더 요청해 처음부터 읽는다.
JARVISEO_TTS_FALLBACK_MODEL=tts-1
JARVISEO_EMBED_MODEL=text-embedding-3-small
# 기억 검색 점수(코사인 유사도) 문턱. 이보다 낮은 기록은 답의 근거로 넘기지 않는다.
JARVISEO_MEMORY_MIN_SCORE=0.15

# --- 식품 성분 판정 -----------------------------------------------------
# 푸드QR(portal.foodqr.kr) 인증키. '푸드QR 알레르기정보' 활용신청이 필요하다.
# 비워 두면 바코드 조회 없이 성분표 OCR 로 간다.
JARVISEO_FOOD_QR_API_KEY=
# OCR 평균 신뢰도 기준. 이보다 낮으면 재처리 → 재촬영 안내.
JARVISEO_OCR_CONF_THRESHOLD=0.8
JARVISEO_OCR_REPROCESS_PER_PHOTO=1
JARVISEO_OCR_MAX_RETAKE=2
# 성분표 OCR 을 Google Cloud Vision 으로 읽는다(Cloud Vision API 를 켠 프로젝트의 API 키).
# 있으면 이것을 먼저 쓰고, 실패하면 아래 Colab → 이 PC 의 EasyOCR 순으로 대신 읽는다.
GOOGLE_VISION_API_KEY=
# 성분표 OCR 을 Colab GPU 서버에 맡길 때 (scripts/colab_ocr_server.py 가 출력하는 값).
# 비워 두면 이 PC 의 EasyOCR(CPU)로 읽는다.
# ngrok 고정 주소 + OCR_TOKEN 을 정해 두면 Colab 을 다시 켜도 값이 그대로다(처음 한 번만 적는다).
JARVISEO_OCR_REMOTE_URL=
JARVISEO_OCR_REMOTE_TOKEN=
# OCR 서버를 띄우는 Colab 노트북 주소. 서버가 꺼져 있으면 /ingredient 페이지에 '여는 버튼'을 보여 준다.
JARVISEO_OCR_NOTEBOOK_URL=

# --- 관계형 DB (Postgres) -----------------------------------------------
# docker compose 로 띄운 Postgres 에 붙는다.
#     docker compose up -d db
#
# 컨테이너 안에서 파이썬을 돌릴 때는 compose 가 DB_HOST 를 db 로 덮어쓴다.
# 그러니 이 파일은 네이티브 실행 기준으로 localhost 로 둔다.
JARVISEO_DB_HOST=localhost
JARVISEO_DB_PORT=5432
JARVISEO_DB_NAME=jarviseo
JARVISEO_DB_USER=jarviseo
JARVISEO_DB_PASSWORD=jarviseo

# 통째로 지정하고 싶으면 이 값을 쓴다. 위 항목들보다 우선한다.
# 컨테이너 없이 SQLite 로 돌리고 싶을 때(발표 데모에서 메모리가 빠듯할 때)
# 주석을 풀면 된다. 코드는 한 줄도 안 바꿔도 된다.
# JARVISEO_DATABASE_URL=sqlite:///data/jarviseo.db

# Postgres 연결을 기다리는 최대 시간(초). 컨테이너가 꺼져 있으면 이 안에 에러를 낸다.
# localhost 는 주소 두 개를 차례로 시도해서 실제로는 2배까지 걸린다.
JARVISEO_DB_CONNECT_TIMEOUT_SEC=3

# --- 음성 ---------------------------------------------------------------
JARVISEO_WAKE_WORD=자비서
# TTS 재생이 끝난 뒤 마이크를 더 막아둘 시간(초). 되먹임 루프 방지.
JARVISEO_TTS_MIC_GATE_SEC=0.3
# 호출어 모델(.onnx 경로나 openWakeWord 기성 모델 이름)과 임계값. 재생 중 임계값은 따로 바꿀 수 있다.
# 모델을 비워 두면 data/models/jarviseo.onnx 를 쓴다(data/README.md 에서 받는 법).
# JARVISEO_WAKEWORD_MODEL=data/models/jarviseo.onnx
JARVISEO_WAKEWORD_THRESHOLD=0.97
JARVISEO_WAKEWORD_PLAYBACK_THRESHOLD=0.97
# 호출어 감지 시각보다 이만큼(초) 앞에서부터 질문을 받아쓴다. 감지가 호출어 끝보다 늦어서다.
JARVISEO_WAKE_LOOKBACK_SEC=1.0
# 호출하면 시작음, 질문하는 말이 끝나면 종료음을 낸다. 소리 크기 0~1, 0 이면 안 낸다.
JARVISEO_CHIME_VOLUME=1.0


# --- LangSmith ---------------------------------------------------------------
# 그래프 노드별 시간·흐름 추적. 평소엔 끄고, 볼 때만 실행 명령 앞에서 켠다
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_여기에_키
LANGSMITH_PROJECT=JARVISEO
